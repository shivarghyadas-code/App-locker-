<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet is used only to load the map pictures (OpenStreetMap) on "Add trusted place".
         The password, settings and location never leave the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Night lock: checks for a trusted place only while the lock screen is open -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Theft alert: texts the location to family numbers after many wrong passwords -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- SOS screen: one-tap call to the saved family numbers (112 always goes through the dialer) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Android 11+: see installed apps (to list them) and the Settings / uninstall screens (to lock them) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.android.settings" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.packageinstaller" />
        <package android:name="com.google.android.packageinstaller" />
        <package android:name="com.android.packageinstaller" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.shivarghya.applocker.lock"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:label="Add trusted place"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />

        <!-- Second app icon "SOS": opens without the password, shows the saved emergency numbers
             and sends the live location to them with one tap. -->
        <activity
            android:name=".SosActivity"
            android:exported="true"
            android:icon="@mipmap/ic_sos"
            android:label="SOS"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="com.shivarghya.applocker.sos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "SOS" tile for the notification panel -->
        <service
            android:name=".SosTile"
            android:exported="true"
            android:icon="@drawable/ic_sos_tile"
            android:label="SOS"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Uninstall protection (device admin) -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".LockService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>
    </application>
</manifest>
